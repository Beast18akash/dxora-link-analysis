# Required: Google Gemini API key (obtain from Google AI Studio; never commit real keys)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Gemini model identifier
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Safe HTTP fetcher limits
HTTP_TIMEOUT_SECONDS=10.0
MAX_HTML_BYTES=2097152
MAX_REDIRECTS=5
MAX_EXTRACTED_TEXT_CHARS=10000
USER_AGENT="WebsiteLinkAnalysisAPI/1.0 (+https://example.com)"
